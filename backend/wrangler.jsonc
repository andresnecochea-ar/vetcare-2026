{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "vetcare-api",
  "account_id": "930d054277b5ab3e2adca108517e9aeb",
  "main": "./worker.ts",
  "compatibility_date": "2026-07-28",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "APP_VERSION": "2.16.0",
    "ALLOWED_ORIGINS": "https://andresnecochea-ar.github.io,null"
  },
  "secrets": {
    "required": ["INVITE_CODE"]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1
    }
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vetcare",
      "database_id": "ff69acbe-d754-4f3a-9b8d-e5811a24156e",
      "migrations_dir": "migrations"
    }
  ]
}
